# Database Configuration
DB_TYPE=sqlite  # or oracle

# SQLite Configuration
SQLITE_DB_PATH=database/reefmapper.db

# Oracle Configuration
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password
# Connection string format: hostname:port/servicename
# Examples:
#   - localhost:1521/XEPDB1 (local Oracle XE)
#   - db-server.company.com/ORCL (default port 1521)
#   - 192.168.1.100:1522/PROD (custom port)
ORACLE_DSN=localhost:1521/XEPDB1
ORACLE_MIN_CONNECTIONS=2
ORACLE_MAX_CONNECTIONS=5
ORACLE_CONNECTION_INCREMENT=1

# Application Configuration
BATCH_SIZE=10
LOG_LEVEL=INFO
